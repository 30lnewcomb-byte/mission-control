<Window x:Class="MissionControl.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MissionControl.Desktop"
        Title="Mission Control"
        Width="1380"
        Height="850"
        MinWidth="1080"
        MinHeight="680"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#0F1929"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" Background="#153B5F" CornerRadius="10">
                        <TextBlock Text="MC"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#83CEFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MISSION CONTROL"
                                   FontSize="18"
                                   FontWeight="Bold" />
                        <TextBlock Text="U.S. SPACEFLIGHT  ·  DESKTOP DASHBOARD"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="LaunchFeedStatusText"
                           Grid.Column="1"
                           Text="SCHEDULE FEED · CONNECTING"
                           Foreground="#9AB0CA"
                           FontSize="10"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,18,0" />

                <TextBlock x:Name="AiStatusText"
                           Grid.Column="2"
                           Text="ORI SMALL MC · CHECKING"
                           Foreground="#82C9FF"
                           FontSize="10"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,18,0" />

                <Button x:Name="PinWindowButton"
                        Grid.Column="3"
                        Content="PIN WINDOW"
                        Click="PinWindowButton_Click"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center" />

                <Button x:Name="RefreshScheduleButton"
                        Grid.Column="4"
                        Content="REFRESH SCHEDULE"
                        Click="RefreshLaunches_Click"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.96*" />
                <ColumnDefinition Width="1.04*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="UPCOMING U.S. LAUNCHES"
                                   FontSize="16"
                                   FontWeight="Bold" />
                        <TextBlock Text="Launch-site country must be explicitly listed as US."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   Margin="0,5,0,0" />
                    </StackPanel>

                    <ListBox x:Name="LaunchesList"
                             Grid.Row="1"
                             ItemsSource="{Binding Launches}"
                             ItemContainerStyle="{StaticResource LaunchListItemStyle}"
                             SelectionChanged="LaunchesList_SelectionChanged"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:LaunchRow}">
                                <Grid Margin="13,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F3F7FF" />
                                        <TextBlock Text="{Binding MetadataLine}"
                                                   FontSize="10"
                                                   Foreground="#91A8C4"
                                                   Margin="0,5,0,0" />
                                        <TextBlock Text="{Binding ScheduledLabel}"
                                                   FontSize="10"
                                                   Foreground="#CFD9E8"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right"
                                                Margin="14,0,0,0">
                                        <TextBlock Text="{Binding CountdownLabel}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="#76C5FF"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding StateLabel}"
                                                   FontSize="9"
                                                   Foreground="#9AB0CA"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,5,0,0"
                                                   MaxWidth="190"
                                                   TextAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="LaunchCountSummary"
                               Grid.Row="2"
                               Text="Schedule data has not loaded yet."
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="10"
                               Margin="0,12,0,0" />
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="18,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Background="#122137"
                        BorderBrush="#2A4260"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="17">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="SELECTED MISSION"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#71C0F9" />
                            <TextBlock x:Name="SelectedLaunchName"
                                       Text="Waiting for schedule data"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Margin="0,8,0,0" />
                            <TextBlock x:Name="SelectedLaunchStatus"
                                       Text="SCHEDULE STATUS · NOT LOADED"
                                       FontSize="10"
                                       Foreground="#C0D0E4"
                                       Margin="0,6,0,0" />
                            <TextBlock x:Name="SelectedLaunchSchedule"
                                       Text="Scheduled time unavailable"
                                       FontSize="11"
                                       Foreground="#9AB0CA"
                                       Margin="0,5,0,0" />
                            <TextBlock x:Name="SelectedLaunchExplanation"
                                       Text="Waiting for countdown explanation."
                                       FontSize="10"
                                       Foreground="#C5D3E6"
                                       Margin="0,6,0,0"
                                       MaxWidth="480" />
                            <TextBlock x:Name="SelectedLaunchTrustText"
                                       Text="SCHEDULE DATA ONLY · NO LIFTOFF INFERENCE"
                                       FontSize="9"
                                       Foreground="#E0B66C"
                                       Margin="0,7,0,0"
                                       Visibility="Collapsed" />
                            <Button x:Name="OpenLaunchDetailsButton"
                                    Content="OPEN LAUNCH RECORD ↗"
                                    Click="OpenLaunchDetails_Click"
                                    IsEnabled="False"
                                    HorizontalAlignment="Left"
                                    Margin="0,9,0,0"
                                    Padding="11,7"
                                    FontSize="10" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="15,0,0,0">
                            <TextBlock Text="COUNTDOWN"
                                       FontSize="9"
                                       Foreground="#92AAC7"
                                       HorizontalAlignment="Right" />
                            <TextBlock x:Name="SelectedLaunchCountdown"
                                       Text="T− --:--:--"
                                       FontFamily="Consolas"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       Foreground="#7BC8FF"
                                       Margin="0,5,0,0"
                                       HorizontalAlignment="Right" />
                        </StackPanel>

                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="17"
                        Margin="0,14,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="ORI SMALL MC"
                                       FontSize="16"
                                       FontWeight="Bold" />
                            <TextBlock Text="GENERAL CHAT · LOCAL MODEL · SPACE IS OPTIONAL"
                                       FontSize="9"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,4,0,0" />
                            <TextBlock x:Name="ChatContextStatusText"
                                       Text="CONTEXT · No launch selected; general chat only"
                                       FontSize="9"
                                       Foreground="#8EA5C2"
                                       Margin="0,4,0,0"
                                       MaxWidth="520"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <ListBox x:Name="ChatMessagesList"
                                 Grid.Row="1"
                                 ItemsSource="{Binding ChatLines}"
                                 ItemContainerStyle="{StaticResource ChatMessageItemStyle}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:ChatLine}">
                                    <StackPanel Margin="0,10,0,10">
                                        <TextBlock Text="{Binding RoleLabel}"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="#69BFFF" />
                                        <TextBlock Text="{Binding Content}"
                                                   FontSize="13"
                                                   Foreground="#E0E8F5"
                                                   LineHeight="20"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Background="#101827"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="13">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ChatInput"
                                 MinHeight="52"
                                 MaxHeight="100"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Ask Ori Small MC anything. Enter sends; Shift+Enter adds a line."
                                 KeyDown="ChatInput_KeyDown" />
                        <Button x:Name="SendChatButton"
                                Grid.Column="1"
                                Content="SEND"
                                Click="SendChat_Click"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                MinWidth="75" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
